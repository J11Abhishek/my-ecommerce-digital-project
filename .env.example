SECRET_KEY=django-insecure-change-this-to-a-long-random-string-for-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Database -----------------------------------------------------------
# SQLite is used by default (zero configuration).
# To switch to PostgreSQL, install psycopg and uncomment:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=ecommerce
# DB_USER=ecommerce
# DB_PASSWORD=ecommerce
# DB_HOST=127.0.0.1
# DB_PORT=5432

# --- Storefront settings ----------------------------------------------
SHIPPING_FEE=50
FREE_SHIPPING_THRESHOLD=1000
CURRENCY_SYMBOL=&#8377;
